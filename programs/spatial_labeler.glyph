; Geometry OS Spatial Labeler
; Turns migrated fragments into indexed metadata

:main
    LDI r10, 0x1001     ; Start of Network Zone (0x1001)
    LDI r11, 0x102D     ; End of Network Zone
    LDI r12, 0x8000     ; Metadata Storage Base (in RAM)

:loop
    LOAD r1, r10        ; Read the Seed Pixel of the fragment
    
    ; Logic: If Seed Pixel is Non-Zero, it's a valid fragment
    JZ r1, :skip
    
    ; Use NEURAL_EVAL to 'guess' the category based on the Seed
    ; (Input = Seed, Weight Address = :label_weights)
    LDI r2, :label_weights
    NEURAL_EVAL r3, r1, r2
    
    ; Store the generated Tag (r3) into our metadata table
    STORE r12, r3
    
    ; Draw a small 'Visual Tag' pixel on the screen to show indexing progress
    HILBERT_D2XY r4, r5, r10 ; Get fragment's screen coords
    LDI r6, 0x00FFFF00       ; Yellow for 'Indexed'
    PSET r4, r5, r6

:skip
    ADD r10, r10, 1     ; Next fragment
    ADD r12, r12, 1     ; Next metadata slot
    SUB r7, r10, r11
    JZ r7, :done
    JMP :loop

:done
    HALT

:label_weights
    ; Neural Weights for "Logic vs Data" detection
    ; Simple thresholding node
    0x3F 0x00 0x00 0x00
