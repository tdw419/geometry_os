# Implementation of task decomposition system

def decompose_task(goal_text):
    # Actual implementation: break a complex goal into atomic steps
    steps = []
    # Example logic: split the goal text by semicolons to get individual steps
    if '; ' in goal_text:
        steps = goal_text.split('; ')
    else:
        steps = [goal_text.strip()]
    return [step.strip() for step in steps if step.strip()]

def execute_step(step, context):
    try:
        # Actual implementation: execute a single step with rollback
        print(f'Executing: {step}')
        # Simulate a failure for demonstration purposes
        if 'fail' in step.lower():
            raise Exception('Simulated step failure')
        result = True  # Assume success for demonstration
        return result
    except Exception as e:
        print(f'Failed to execute step: {e}')
        rollback(step, context)
        raise

def validate_step_completion(step, result):
    # Actual implementation: checks if step succeeded
    if result is True:
        print(f'Step completed successfully: {step}')
        return True
    else:
        print(f'Step failed: {step}')
        return False

def rollback(step, context):
    # Actual implementation: undo last failed modification
    print(f'Rolling back step: {step}')
    # Placeholder for actual rollback logic
    pass