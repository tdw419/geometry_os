#!/usr/bin/env cargo script
//!
//! Refinery Spatial Grid Demo
//!
//! Demonstrates the refinery simulation rendering on Geometry OS 128x64 spatial grid
//!
//! This demo:
//! 1. Creates a refinery with pipes, tanks, pumps, and equipment
//! 2. Runs a simulation loop
//! 3. Renders to spatial cells
use infinite_map_rs::geoasm_materializer::CellState;
use infinite_map_rs::refinery::simulation::RefinerySimulation;
use infinite_map_rs::refinery::visualization::RefineryRenderer;
use infinite_map_rs::spatial::grid_runner::{GridRunner, GRID_H, GRID_W};
use std::time::Duration;

/// Show the CPU demo output (grid preview, tank levels, pipe flows)
fn show_cpu_demo(
    sim: &RefinerySimulation,
    cells: &[CellState],
    grid_width: usize,
    grid_height: usize,
) {
    // Show ASCII preview (simple grid sampling)
    println!("ASCII Grid Preview (every 8th cell):");
    println!();
    for row in (0..grid_height).step_by(8) {
        println!("{:4} |", row);
        for col in (0..grid_width).step_by(8) {
            let idx = row * grid_width + col;
            let cell = &cells[idx];

            // Simple character representation
            let ch = if cell.opcode_or_type == 17 {
                '·' // NOP
            } else if cell.opcode_or_type >= 18 && cell.opcode_or_type <= 25 {
                // Refinery equipment types
                match cell.opcode_or_type {
                    18 => '≈', // Oil flow
                    19 => '◉', // Valve
                    20 => '◎', // Pump
                    21 => '☀', // Heater
                    22 => '◫', // Separator
                    23 => '▮', // Storage
                    24 => '✚', // Sensor
                    25 => '⨁', // Mixer
                    _ => '?',
                }
            } else {
                '#' // Other cell types
            };

            print!(" {} ", ch);
        }
        println!();
    }
    println!();

    // Show equipment layout
    println!("Equipment Layout:");
    println!();
    for equipment in &sim.state().equipment {
        let x_grid = (equipment.position.0 as i32 / 2).clamp(0, 127);
        let y_grid = (equipment.position.1 as i32 / 2).clamp(0, 63);
        println!(
            "  {} ({:3}, {:3}): {}",
            equipment.id, x_grid, y_grid, equipment.equipment_type.as_str()
        );
    }
    println!();

    // Show tank levels
    println!("Tank Levels:");
    println!();
    for tank in &sim.state().tanks {
        let fill_percent = (tank.current_volume / tank.capacity) * 100.0;
        let bar_len = (fill_percent / 5.0) as usize;
        let bar = "█".repeat(bar_len) + &"░".repeat(20 - bar_len);
        println!("  {} |{}| {:.1}%", tank.name, bar, fill_percent);
    }
    println!();

    // Show pipe flows
    println!("Pipe Flows:");
    println!();
    for pipe in &sim.state().pipes {
        let flow_dir = if pipe.flow_rate > 0.0 {
            "→"
        } else if pipe.flow_rate < 0.0 {
            "←"
        } else {
            "•"
        };
        println!(
            "  {} {} {:.3} m³/s (P: {:.2} MPa, T: {:.1} K)",
            pipe.id,
            flow_dir,
            pipe.flow_rate.abs(),
            pipe.pressure / 1e6,
            pipe.temperature - 273.15
        );
    }
    println!();

    println!("═══════════════════════════════════════════════════════════════");
    println!("  Demo complete! The refinery is now rendered on the spatial grid.");
    println!("═══════════════════════════════════════════════════════════════");
}

fn main() {
    println!("═══════════════════════════════════════════════════════════════");
    println!("  Refinery Spatial Grid Demo");
    println!("  Rendering refinery simulation on Geometry OS 128x64 spatial grid");
    println!("═══════════════════════════════════════════════════════════════");
    println!();

    // Create refinery simulation
    println!("Creating refinery simulation...");
    let (state, connections) = RefinerySimulation::create_mvp_layout();
    println!("  - Pipes: {}", state.pipes.len());
    println!("  - Tanks: {}", state.tanks.len());
    println!("  - Connections: {}", connections.len());
    println!();

    // Run simulation
    let mut sim = RefinerySimulation::new(state, 1.0);
    for connection in connections {
        sim.add_connection(connection);
    }

    println!("Created refinery visualizer");
    let mut visualizer = RefineryRenderer::with_defaults();

    println!();
    println!("Running simulation for 10 steps...");
    for i in 0..10 {
        let _ = sim.step();
        if i == 0 || i == 5 {
            println!("  Step {}: time = {:.2}s", i, sim.state().time);
        }
    }
    println!();

    // Render to spatial cells
    println!("Rendering refinery to 128x64 spatial grid...");
    visualizer.render_state(sim.state(), 0.0);
    let grid_width = 128;
    let grid_height = 64;
    let cells = visualizer.to_spatial_cells(grid_width, grid_height);
    let render_elements_count = visualizer.render_elements
        .iter()
        .filter(|e| {
            use infinite_map_rs::refinery::visualization::RenderElement;
            matches!(e, RenderElement::Pipe { .. } | RenderElement::Tank { .. })
        })
        .count();
    println!("  - Render elements: {}", render_elements_count);
    println!();

    // Show statistics
    println!("Spatial grid statistics:");
    let active_cells = cells.iter().filter(|c| c.is_active > 0).count();
    let colored_cells = cells.iter().filter(|c| c.opcode_or_type != 17).count();
    println!("  - Active cells: {} / {}", active_cells, cells.len());
    println!("  - Non-NOP cells: {} / {}", colored_cells, cells.len());

    // Show positions of non-NOP cells
    let non_nop_positions: Vec<_> = cells
        .iter()
        .enumerate()
        .filter(|(_, c)| c.opcode_or_type != 17)
        .map(|(i, c)| {
            (
                i / grid_width,
                i % grid_width,
                c.opcode_or_type,
                c.data_buffer,
            )
        })
        .collect();

    if !non_nop_positions.is_empty() {
        println!("\nNon-NOP cell positions:");
        for (y, x, opcode, data) in non_nop_positions.iter().take(20) {
            let symbol = match opcode {
                18 => "≈",
                19 => "◉",
                20 => "◎",
                21 => "☀",
                22 => "◫",
                23 => "▮",
                24 => "✚",
                25 => "⨁",
                _ => "?",
            };
            println!(
                "  ({:3}, {:2}) opcode={} {} data={:08x}",
                x, y, opcode, symbol, data
            );
        }
        if non_nop_positions.len() > 20 {
            println!("  ... and {} more", non_nop_positions.len() - 20);
        }
    }
    println!();

    // ========================================
    // GPU GridRunner Execution Attempt
    // ========================================
    println!("═══════════════════════════════════════════════════════════════");
    println!("  GPU GridRunner Execution");
    println!("═══════════════════════════════════════════════════════════════");
    println!();

    // Initialize GridRunner (async, blocking for demo)
    println!("Initializing GridRunner...");
    let mut grid_runner = match pollster::block_on(GridRunner::new()) {
        Ok(gr) => {
            println!("  ✓ GridRunner initialized");
            gr
        }
        Err(e) => {
            eprintln!("  ✗ Failed to initialize GridRunner: {}", e);
            println!("  Skipping GPU execution (continuing with CPU demo)");
            println!("═══════════════════════════════════════════════════════════════");
            println!();

            // Continue with CPU-only demo
            show_cpu_demo(&sim, &cells, grid_width, grid_height);
            return;
        }
    };

    // Convert to binary format with header
    // Use GridRunner's actual dimensions (512x256 with larger_grid feature)
    println!(
        "Converting {} cells to GPU overlay bytes...",
        cells.len()
    );
    let overlay_bytes = visualizer.to_binary(GRID_W, GRID_H);
    println!(
        "  ✓ Overlay bytes prepared ({} bytes)",
        overlay_bytes.len()
    );

    // Load overlay into GPU
    println!("Loading refinery cells into GPU overlay...");
    if let Err(e) = grid_runner.load_overlay(&overlay_bytes) {
        eprintln!("  ✗ Failed to load overlay: {}", e);
        println!("  Note: GridRunner expects grid sizes matching compile-time constants.");
        println!("  GPU execution not available - continuing with CPU demo.");
        println!("═══════════════════════════════════════════════════════════════");
        println!();

        // Continue with CPU-only demo (no GPU execution)
        show_cpu_demo(&sim, &cells, grid_width, grid_height);
        return;
    }
    println!("  ✓ Overlay loaded");

    // Run spatial ticks
    println!();
    println!("Running 10 spatial ticks on GPU...");
    let tick_count = 10;
    for i in 0..tick_count {
        let _ = grid_runner.tick();
        if (i + 1) % 5 == 0 {
            println!("  Tick {}/{}", i + 1, tick_count);
        }
    }
    println!("  ✓ All ticks executed");

    // Read back grid state (async)
    println!();
    println!("Reading grid state from GPU...");
    let gpu_cells = match pollster::block_on(grid_runner.read_grid()) {
        Ok(cells) => {
            println!("  ✓ Grid read back ({} cells)", cells.len());
            cells
        }
        Err(e) => {
            eprintln!("  ✗ Failed to read grid: {}", e);
            println!("  Using pre-GPU cells for verification");
            cells.clone()
        }
    };

    // Verify refinery cells are still present
    println!();
    let gpu_active = gpu_cells.iter().filter(|c| c.is_active > 0).count();
    let gpu_non_nop = gpu_cells.iter().filter(|c| c.opcode_or_type != 17).count();
    println!("GPU grid statistics after {} ticks:", tick_count);
    println!("  - Active cells: {} / {}", gpu_active, gpu_cells.len());
    println!("  - Non-NOP cells: {} / {}", gpu_non_nop, gpu_cells.len());

    // Check if refinery equipment opcodes are present
    let mut refinery_opcodes: Vec<_> = gpu_cells
        .iter()
        .filter(|c| c.opcode_or_type >= 18 && c.opcode_or_type <= 25)
        .map(|c| c.opcode_or_type)
        .collect::<std::collections::HashSet<_>>()
        .into_iter()
        .collect();
    refinery_opcodes.sort();

    if !refinery_opcodes.is_empty() {
        println!("  - Refinery opcodes present: {:?}", refinery_opcodes);
        println!("  ✓ GPU execution verified - refinery cells preserved");
    } else {
        println!("  ⚠ No refinery opcodes found in GPU grid");
    }

    println!();
    println!("═══════════════════════════════════════════════════════════════");
    println!();

    // Show ASCII preview from GPU grid
    println!("ASCII Grid Preview (from GPU, every 8th cell):");
    println!();
    for row in (0..grid_height).step_by(8) {
        println!("{:4} |", row);
        for col in (0..grid_width).step_by(8) {
            let idx = row * grid_width + col;
            let cell = &gpu_cells[idx];

            // Simple character representation
            let ch = if cell.opcode_or_type == 17 {
                '·' // NOP
            } else if cell.opcode_or_type >= 18 && cell.opcode_or_type <= 25 {
                // Refinery equipment types
                match cell.opcode_or_type {
                    18 => '≈', // Oil Flow
                    19 => '◉', // Valve
                    20 => '◎', // Pump
                    21 => '☀', // Heater
                    22 => '◫', // Separator
                    23 => '▮', // Storage
                    24 => '✚', // Sensor
                    25 => '⨁', // Mixer
                    _ => '?',
                }
            } else {
                '#' // Other cell types
            };

            print!(" {} ", ch);
        }
        println!();
    }
    println!();

    // Show refinery state information
    println!("Refinery State (CPU simulation):");
    for equipment in &sim.state().equipment {
        let x_grid = (equipment.position.0 as i32 / 2).clamp(0, 127);
        let y_grid = (equipment.position.1 as i32 / 2).clamp(0, 63);
        println!(
            "  {} ({:3}, {:3}): {}",
            equipment.id, x_grid, y_grid, equipment.equipment_type.as_str()
        );
    }
    println!();

    // Show tank levels
    println!("Tank Levels:");
    println!();
    for tank in &sim.state().tanks {
        let fill_percent = (tank.current_volume / tank.capacity) * 100.0;
        let bar_len = (fill_percent / 5.0) as usize;
        let bar = "█".repeat(bar_len) + &"░".repeat(20 - bar_len);
        println!("  {} |{}| {:.1}%", tank.name, bar, fill_percent);
    }
    println!();

    // Show pipe flows
    println!("Pipe Flows:");
    println!();
    for pipe in &sim.state().pipes {
        let flow_dir = if pipe.flow_rate > 0.0 {
            "→"
        } else if pipe.flow_rate < 0.0 {
            "←"
        } else {
            "•"
        };
        println!(
            "  {} {} {:.3} m³/s (P: {:.2} MPa, T: {:.1} K)",
            pipe.id,
            flow_dir,
            pipe.flow_rate.abs(),
            pipe.pressure / 1e6,
            pipe.temperature - 273.15
        );
    }
    println!();

    println!("═══════════════════════════════════════════════════════════════");
    println!("  Demo complete! The refinery is now rendered on the spatial grid.");
    println!("═══════════════════════════════════════════════════════════════");
}