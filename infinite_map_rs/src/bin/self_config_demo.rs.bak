//! Demo binary for Phase 12.5: Self-Configuration System
//!
//! Demonstrates the complete self-configuration pipeline:
//! 1. Hardware discovery via MMIO
//! 2. Resource allocation
//! 3. Driver loading
//! 4. Service initialization

use geometry_os::spatial::self_config::{ConfigReport, ConfigStage, SelfConfigurator};
use std::io::{self, Write};

fn print_header(title: &str) {
    println!();
    println!("╔════════════════════════════════════════════════════════════╗");
    println!("║  {:56} ║", title);
    println!("╚════════════════════════════════════════════════════════════╝");
}

fn print_step(step: u8, description: &str) {
    println!();
    println!("📋 Step {}: {}", step, description);
}

fn print_success(message: &str) {
    println!("   ✓ {}", message);
}

fn print_info(message: &str) {
    println!("   ℹ  {}", message);
}

fn print_error(message: &str) {
    eprintln!("   ✗ {}", message);
}

fn format_bytes(bytes: u32) -> String {
    if bytes >= 1024 * 1024 {
        format!("{:.2} MB", bytes as f32 / (1024.0 * 1024.0))
    } else if bytes >= 1024 {
        format!("{:.2} KB", bytes as f32 / 1024.0)
    } else {
        format!("{} B", bytes)
    }
}

fn print_report(report: &ConfigReport) {
    println!();
    println!("📊 Configuration Report:");
    println!("   Stage: {:?}", report.stage);
    println!("   Devices Found: {}", report.devices_found);
    println!("   Drivers Loaded: {}", report.drivers_loaded);
    println!("   Services Running: {}", report.services_running);
    println!(
        "   Memory Used: {} / {} ({:.1}%)",
        format_bytes(report.memory_used),
        format_bytes(report.memory_total),
        report.memory_percentage
    );
}

fn main() {
    print_header("Geometry OS Phase 12.5: Self-Configuration Demo");

    println!();
    println!("This demo demonstrates the autonomous self-configuration system");
    println!("that enables PNG-borne systems to discover hardware, allocate");
    println!("resources, load drivers, and initialize services without");
    println!("external configuration.");

    // Create configurator
    print_step(1, "Initialize Self-Configurator");
    let mut configurator = SelfConfigurator::new();
    print_success("Self-configurator created");

    // Configure step by step
    print_step(2, "Hardware Discovery");
    match configurator.discover_hardware() {
        Ok(_) => print_success("Hardware discovered successfully"),
        Err(e) => {
            print_error(&format!("Hardware discovery failed: {}", e));
            return;
        }
    }

    if let Some(result) = &configurator.discovery_result {
        print_info(&format!("Found {} devices", result.devices.len()));
        for device in &result.devices {
            print_info(&format!(
                "  - {}: base=0x{:08x}, caps={:?}",
                device.name, device.base_addr, device.caps
            ));
        }
        print_info(&format!("Total memory: {} cells", result.total_memory));
    }

    print_step(3, "Resource Allocation");
    match configurator.allocate_resources() {
        Ok(_) => print_success("Resources allocated successfully"),
        Err(e) => {
            print_error(&format!("Resource allocation failed: {}", e));
            return;
        }
    }

    let (used, total, pct) = configurator.resources.get_memory_usage();
    print_info(&format!(
        "Memory: {} / {} ({:.1}%)",
        format_bytes(used),
        format_bytes(total),
        pct
    ));

    print_step(4, "Driver Loading");
    match configurator.load_drivers() {
        Ok(_) => print_success("Drivers loaded successfully"),
        Err(e) => {
            print_error(&format!("Driver loading failed: {}", e));
            return;
        }
    }

    if let Some(result) = &configurator.discovery_result {
        print_info(&format!("Loaded {} drivers", result.devices.len()));
    }

    print_step(5, "Service Initialization");
    match configurator.start_services() {
        Ok(_) => print_success("Services started successfully"),
        Err(e) => {
            print_error(&format!("Service initialization failed: {}", e));
            return;
        }
    }

    // List running services
    let services = configurator.service_manager.list_services();
    print_info(&format!("Running services: {}", services.len()));
    for service in services {
        print_info(&format!(
            "  - [{}] {:?} (PID: {})",
            if service.state == geometry_os::spatial::self_config::ServiceState::Running {
                "✓"
            } else {
                "✗"
            },
            service.state,
            service.pid
        ));
    }

    // Print final report
    print_header("Configuration Complete");
    let report = configurator.get_report();
    print_report(&report);

    println!();
    print_success("Phase 12.5 Self-Configuration: COMPLETE");
    println!();
    println!("The system has successfully:");
    println!("  • Discovered available hardware devices");
    println!("  • Allocated memory, devices, and interrupt lines");
    println!("  • Loaded appropriate drivers for each device");
    println!("  • Initialized system services in dependency order");
    println!();
    println!("This enables PNG-borne systems to boot and configure");
    println!("themselves autonomously without external assistance.");
    println!();
}