# ── PCI (disabled — no PCI in GeOS virt machine) ───────────────────────
# CONFIG_PCI is not set

# ── Power management ───────────────────────────────────────────────────
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set

# ── Networking (minimal) ───────────────────────────────────────────────
CONFIG_NET=y
