# ── IRQ / IRQCHIP ──────────────────────────────────────────────────────
CONFIG_IRQCHIP=y
CONFIG_OF=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
