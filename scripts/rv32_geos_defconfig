# RV32 GeOS Virtual Machine Defconfig
#
# Minimal but complete configuration for booting Linux inside the
# Geometry OS RISC-V hypervisor. Matches the DTB layout:
#   - CPU: rv32imac, Sv32 MMU
#   - UART: ns16550a at 0x10000000
#   - CLINT: riscv,clint0 at 0x02000000
#   - PLIC: riscv,plic0 at 0x0C000000
#   - VirtIO: mmio at 0x10001000/0x10002000/0x10003000
#
# Build with:
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- rv32_geos_defconfig
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- -j$(nproc) vmlinux

# ── Architecture ───────────────────────────────────────────────────────
CONFIG_32BIT=y
CONFIG_ARCH_RV32I=y
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
CONFIG_ARCH_RISCV=y
CONFIG_RISCV=y

# ── Essential kernel services ──────────────────────────────────────────
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# ── Block layer ────────────────────────────────────────────────────────
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y

# ── Initramfs ──────────────────────────────────────────────────────────
CONFIG_RD_GZIP=y

# ── Serial console (8250/16550A at 0x10000000) ─────────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DEPRECATED_OPTIONS=y
CONFIG_SERIAL_8250_16550A_VARIANTS=y
